PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL="postgresql://username:password@localhost:5432/database"
SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/database_shadow"
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed CORS origins (each must be a valid URL)
WHITE_LIST_URLS=http://localhost:3000,http://localhost:4000,http://localhost:5173
